{
  "name": "voltia",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "migrate:photos": "node scripts/migrate-photos.mjs",
    "stations:refresh": "node scripts/stations-refresh.mjs",
    "stations:report": "node scripts/stations-report.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "diagnose:route": "node scripts/diagnose-route.mjs",
    "snapshot:record": "vitest run --config vitest.record.config.ts"
  },
  "dependencies": {
