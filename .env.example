# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a git (ya está en .gitignore).

# Conexión a Postgres (Supabase). Obligatoria en todo entorno, incluido local — sin ella, getSql() falla al arrancar.
# En producción serverless usa el connection pooler de Supabase (puerto 6543,
# modo transaction, en el connection string trae `?pgbouncer=true`), no el 5432
# directo — ver src/infrastructure/db.ts. Local puede usar 5432 sin problema.
DATABASE_URL=

# Clave privada de Supabase (sb_secret_...). Solo servidor. No la pongas en NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_MAPBOX_TOKEN=

# Token de PlugShare para consultar cargadores. Solo servidor: el navegador ya no maneja ninguna credencial de PlugShare (sin él, la capa de PlugShare simplemente no aparece).
PLUGSHARE_TOKEN=

# Token del registro nacional de electrolineras (SIVEEIC, MinEnergía). Solo servidor (sin él, esa capa simplemente no aparece).
SIVEEIC_TOKEN=

# Correos separados por coma con rol admin (moderar electrolineras).
ADMIN_EMAILS=

# Protege POST /api/stations/refresh (cron de Vercel / `npm run stations:refresh`).
CRON_SECRET=

# Identifica la app y da un contacto en las llamadas a Overpass/Photon (APIs
# públicas que lo piden en su política de uso). Ej: "https://voltia.app; soporte@voltia.app".
PROVIDER_CONTACT=

# Token de Mapbox SOLO para el servidor (Directions: driving-traffic).
# Si el token público tiene restricción por URL, las llamadas del servidor
# no envían Referer y Mapbox las rechaza (403) — usa un sk. o un pk. sin
# restricción de URL aquí. Sin ningún token, las rutas usan OSRM público
# (distancias que pueden diferir ~30 km de Google) y la UI lo avisa.
MAPBOX_ACCESS_TOKEN=

# Motor de planificación (ADR-0007): legacy (por defecto), shadow (calcula los
# dos, responde con el actual y registra diferencias) o v2.
PLANNER_ENGINE=legacy

# Selector de motor v1/v2 en el planificador (vista previa). "*" = todos,
# invitados incluidos (por defecto); o correos separados por coma para
# limitarlo. v1 = planificador y energía actuales; v2 = planificador nuevo y
# energía física. El servidor lo verifica.
ENGINE_PREVIEW_EMAILS=*

# Modelo de energía (ADR-0012): legacy (por defecto), shadow (calcula los dos,
# responde con el actual y registra [plan-trip:energy-shadow]) o v2 (física por
# tramo sin multiplicadores y perfil de velocidad con curvas y límites legales).
ENERGY_ENGINE=legacy

# Desvíos a las electrolineras (ADR-0013): estimated (línea recta × factor, por
# defecto, sin consultas) o matrix (medidos por vía con la Matrix API de Mapbox:
# hasta 24 estaciones compatibles por ruta, 2 consultas por cada 12; caché 7 días).
DETOUR_SOURCE=estimated

# Fuente de elevación (ADR-0011). Compara con `npm run elevation:compare`.
#   mapbox-terrain       teselas de terreno de Mapbox cada 100 m (por defecto, D1); usa MAPBOX_ACCESS_TOKEN
#   open-meteo           96 puntos por ruta, 1 consulta
#   open-meteo-adaptive  1 punto por km y cada 200 m donde cambia la altura; varias consultas
# La elevación se guarda en caché sin vencimiento (no cambia), compartida por todos los usuarios.
# Si la elegida falla, se usa open-meteo. En el log: [elevation] fuente, puntos, ms y desnivel.
ELEVATION_SOURCE=mapbox-terrain

# Fuente del listado de electrolineras (ADR-0008): blaze o legacy (dataset
# consolidado de OSM, SIVEEIC, comunidad y catálogo). Sin definir: blaze si hay
# BLAZE_API_KEY, si no legacy. Prueba de la key: `npm run blaze:check`.
DATA_SOURCE=
BLAZE_API_URL=https://blaze.muvatec.com/electrolineras-api/public/v1
# Secreta: solo en .env.local y en Vercel, nunca en el repo ni en el navegador.
BLAZE_API_KEY=
