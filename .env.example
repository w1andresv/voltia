# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a git (ya está en .gitignore).

# Conexión a Postgres (Supabase). Obligatoria en todo entorno, incluido local — sin ella, getSql() falla al arrancar.
# En producción serverless usa el connection pooler de Supabase (puerto 6543,
# modo transaction, en el connection string trae `?pgbouncer=true`), no el 5432
# directo — ver src/infrastructure/db.ts. Local puede usar 5432 sin problema.
DATABASE_URL=

# Clave privada de Supabase (sb_secret_...). Solo servidor. No la pongas en NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_MAPBOX_TOKEN=

# Token de PlugShare para consultar cargadores. Solo servidor: el navegador ya no maneja ninguna credencial de PlugShare (sin él, la capa de PlugShare simplemente no aparece).
PLUGSHARE_TOKEN=

# Correos separados por coma con rol admin (moderar electrolineras).
ADMIN_EMAILS=

# Identifica la app y da un contacto en las llamadas a Overpass/Photon (APIs
# públicas que lo piden en su política de uso). Ej: "https://voltia.app; soporte@voltia.app".
PROVIDER_CONTACT=

# Opcional: token de Mapbox SOLO para el servidor (cálculo de rutas con Mapbox Directions).
# Si no se define, se usa NEXT_PUBLIC_MAPBOX_TOKEN. Útil si el token público tiene
# restricción por URL (las llamadas del servidor no envían Referer y Mapbox las rechaza).
# Sin ningún token, las rutas usan los servidores públicos de OSRM (menos precisos).
MAPBOX_ACCESS_TOKEN=
