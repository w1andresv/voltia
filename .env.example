# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a git (ya está en .gitignore).

# Conexión a Postgres (Supabase). Vacía en desarrollo local usa PGLite.
DATABASE_URL=

# Clave privada de Supabase (sb_secret_...). Solo servidor. No la pongas en NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_MAPBOX_TOKEN=

# Token de PlugShare para consultar cargadores. Solo servidor (fase 1 lo saca de NEXT_PUBLIC_).
PLUGSHARE_TOKEN=

# Correos separados por coma con rol admin (moderar electrolineras).
ADMIN_EMAILS=
